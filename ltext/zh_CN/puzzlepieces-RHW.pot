msgctxt "2026960B-2A592FD1-57700000"
msgid ""
"1-Level Flexible Onslope (FlexOST)\n"
"\n"
"Can be overridden to become onslope for other networks.  Default is L0 to L1 RHW-2"
msgstr ""
"1层柔性坡上 (FlexOST)\n"
"\n"
"可被覆盖为其他网络的坡上。默认为L0到L1 RHW-2"

msgctxt "2026960B-2A592FD1-57700100"
msgid ""
"2-Level Flexible Onslope (FlexOST)\n"
"\n"
"Can be overridden to become onslope for other networks.  Default is L0 to L2 RHW-2"
msgstr ""
"2层柔性坡上 (FlexOST)\n"
"\n"
"可被覆盖为其他网络的坡上。默认为L0到L2 RHW-2"

msgctxt "2026960B-2A592FD1-57700200"
msgid ""
"1-Level Flexible Height Transition (FlexHT)\n"
"\n"
"Can be overridden to become onslope for other networks.  Default is L0 to L1 RHW-2"
msgstr ""
"1层柔性高度转换 (FlexHT)\n"
"\n"
"可被覆盖为其他网络的坡上。默认为L0到L1 RHW-2"

msgctxt "2026960B-2A592FD1-57700300"
msgid ""
"2-Level Flexible Height Transition (FlexHT)\n"
"\n"
"Can be overridden to become onslope for other networks.  Default is L0 to L2 RHW-2"
msgstr ""
"2层柔性高度转换 (FlexHT)\n"
"\n"
"可被覆盖为其他网络的坡上。默认为L0到L2 RHW-2"

msgctxt "2026960B-2A592FD1-57700800"
msgid ""
"1-Level Flexible Height Transition (FlexHT) - DIAGONAL\n"
"\n"
"Can be overridden to become onslope for other networks.  Default is L0 to L1 RHW-2"
msgstr ""
"1层柔性高度转换 (FlexHT)- 斜向\n"
"\n"
"可被覆盖为其他网络的坡上。默认为L0到L1 RHW-2"

msgctxt "2026960B-2A592FD1-57701400"
msgid ""
"FLEX Width Transition (FLEX-WT) for Same Network Type (S-to-S/C-to-C)\n"
"\n"
"Lane Add Version\n"
"\n"
"Connect in appropriate network(s) to convert the transition to match."
msgstr ""
"同类型网络的FLEX宽度转换 (FLEX-WT) (S到S/C到C)\n"
"\n"
"车道增加版本\n"
"\n"
"连接适当的网络以转换匹配。"

msgctxt "2026960B-2A592FD1-57707000"
msgid ""
"1-Level FLEX Height Transition (FLEX-HT) - 90° Curved\n"
"\n"
"Default is RHW-2, supports L0-L1 MIS and L0-L1 RHW-4\n"
"\n"
"Connect in appropriate network(s) to convert the transition to match."
msgstr ""
"1层FLEX高度转换 (FLEX-HT)- 90°弯曲\n"
"\n"
"默认为RHW-2，支持L0-L1 MIS和L0-L1 RHW-4\n"
"\n"
"连接适当的网络以转换匹配。"

msgctxt "2026960B-2A592FD1-57707A0F"
msgid "Real Highway (RHW) Flex Diagonal On Slope Transition (Level 2). Can be used for RHW 2, MIS and RHW 4. No other networks are supported!"
msgstr "真实高速公路 (RHW) 柔性斜向坡上转换(2层)。可用于RHW 2、MIS和RHW 4。不支持其他网络！"

msgctxt "2026960B-2A592FD1-5770A00F"
msgid ""
"MRC Flex HT (Radius 3)\n"
"\n"
"Default L0_^/L1 RHW2\n"
"\n"
"Other heights\n"
"\n"
"L0_^/ L1 MIS, RHW4S\n"
"\n"
"L1 _^/ L2 MIS, RHW4S\n"
"\n"
"L2_^/ L3 MIS, RHW4S\n"
"\n"
"L3_ ^/ L4 MIS, RHW4S"
msgstr ""
"MRC柔性HT (半径3)\n"
"\n"
"默认L0上坡至L1 RHW2\n"
"\n"
"其他高度\n"
"\n"
"L0上坡至L1 MIS、RHW4S\n"
"\n"
"L1上坡至L2 MIS、RHW4S\n"
"\n"
"L2上坡至L3 MIS、RHW4S\n"
"\n"
"L3上坡至L4 MIS、RHW4S"

msgctxt "2026960B-2A592FD1-5770F00F"
msgid ""
"MRC Flex HT (Radius 3)\n"
"\n"
"Default L1_^/L0 RHW2\n"
"\n"
"Other heights\n"
"\n"
"L1_\\/ L0 MIS, RHW4S\n"
"\n"
"L2 _\\/ L1 MIS, RHW4S\n"
"\n"
"L3_\\/ L2 MIS, RHW4S\n"
"\n"
"L4_ \\/ L3 MIS, RHW4S"
msgstr ""
"MRC柔性HT (半径3)\n"
"\n"
"默认L1下坡至L0 RHW2\n"
"\n"
"其他高度\n"
"\n"
"L1下坡至L0 MIS、RHW4S\n"
"\n"
"L2下坡至L1 MIS、RHW4S\n"
"\n"
"L3下坡至L2 MIS、RHW4S\n"
"\n"
"L4下坡至L3 MIS、RHW4S"

msgctxt "2026960B-2A592FD1-5770FA0F"
msgid "Real Highway (RHW) Flex Diagonal On Slope Transition (Level 1). Can be used for RHW 2, MIS and RHW 4. No other networks are supported!"
msgstr "真实高速公路 (RHW) 柔性斜向坡上转换(1层)。可用于RHW 2、MIS和RHW 4。不支持其他网络！"

